[Unit]
Description=Web3 GitHub Secret Lead Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/web3-secret-bot
EnvironmentFile=-/etc/web3-secret-bot/env
ExecStart=/usr/bin/python3 -m web3_secret_bot.cli --config /etc/web3-secret-bot/config.ini run
